@@ -0,0 +1,77 @@
+//go:build !amd64
+
+package dpf
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"encoding/binary"
+	"unsafe"
+)
+
+type aesPrf struct {
+	enc []uint32
+}
+
+func newCipher(key []byte) (*aesPrf, error) {
+	n := 11 * 4
+	c := aesPrf{make([]uint32, n)}
+	expandKeyAsm(&key[0], &c.enc[0])
+	return &c, nil
+}
+
+func (c *aesPrf) BlockSize() int { return 16 }
+
+func (c *aesPrf) Encrypt(dst, src []byte) {
+	encryptAes128(&c.enc[0], &dst[0], &src[0])
+}
+
+// The amd64 helpers read AES round keys from the schedule buffer. Here the buffer
+// address only identifies a crypto/aes cipher. expandKeyAsm runs only from package
+// init (prfL, prfR, keyL, keyR), so this list is fixed before any concurrent use.
+var schedules []schedule
+
+type schedule struct {
+	xk    *uint32
+	block cipher.Block
+}
+
+func blockFor(xk *uint32) cipher.Block {
+	for _, s := range schedules {
+		if s.xk == xk {
+			return s.block
+		}
+	}
+	panic("dpf: key schedule was not expanded by expandKeyAsm")
+}
+
+func bytes16(p *byte) []byte { return unsafe.Slice(p, 16) }
+
+func xor16(dst, a, b *byte) {
+	x, y, d := bytes16(a), bytes16(b), bytes16(dst)
+	lo := binary.LittleEndian.Uint64(x[:8]) ^ binary.LittleEndian.Uint64(y[:8])
+	hi := binary.LittleEndian.Uint64(x[8:]) ^ binary.LittleEndian.Uint64(y[8:])
+	binary.LittleEndian.PutUint64(d[:8], lo)
+	binary.LittleEndian.PutUint64(d[8:], hi)
+}
+
+func encryptAes128(xk *uint32, dst, src *byte) {
+	blockFor(xk).Encrypt(bytes16(dst), bytes16(src))
+}
+
+// dst = AES_k(src) XOR src. Callers pass dst == src, so src is saved before encrypting.
+func aes128MMO(xk *uint32, dst, src *byte) {
+	s, d := bytes16(src), bytes16(dst)
+	lo, hi := binary.LittleEndian.Uint64(s[:8]), binary.LittleEndian.Uint64(s[8:])
+	blockFor(xk).Encrypt(d, s)
+	binary.LittleEndian.PutUint64(d[:8], binary.LittleEndian.Uint64(d[:8])^lo)
+	binary.LittleEndian.PutUint64(d[8:], binary.LittleEndian.Uint64(d[8:])^hi)
+}
+
+func expandKeyAsm(key *byte, enc *uint32) {
+	b, err := aes.NewCipher(bytes16(key))
+	if err != nil {
+		panic("dpf: can't init AES")
+	}
+	schedules = append(schedules, schedule{enc, b})
+}
