*.aux
*.fdb_latexmk
*.fls
report.log
*.out
*.synctex.gz
# Load-generator query corpora: rebuilt by make concurrency, and S3's passes GitHub's 100 MB limit
results/raw/**/loadgen/corpus/*.bin
